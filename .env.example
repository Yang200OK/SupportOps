SUPPORTOPS_POSTGRES_PASSWORD=replace_with_generated_admin_password
SUPPORTOPS_APP_PASSWORD=replace_with_generated_app_password
# Windows 保留默认端口时，显式调整此端口及下面四个 URL，不自动探测或换端口。
SUPPORTOPS_POSTGRES_PORT=55432
SUPPORTOPS_DATABASE_URL=postgresql+psycopg://supportops_app:replace_with_generated_app_password@127.0.0.1:55432/supportops
SUPPORTOPS_ADMIN_DATABASE_URL=postgresql+psycopg://supportops_admin:replace_with_generated_admin_password@127.0.0.1:55432/supportops
SUPPORTOPS_TEST_DATABASE_URL=postgresql+psycopg://supportops_app:replace_with_generated_app_password@127.0.0.1:55432/supportops_test
SUPPORTOPS_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://supportops_admin:replace_with_generated_admin_password@127.0.0.1:55432/supportops_test

# 密钥直接读取当前进程的 DASHSCOPE_API_KEY；也可显式配置项目独立变量。
# SUPPORTOPS_MODEL_API_KEY=replace_with_your_project_key
SUPPORTOPS_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPPORTOPS_MODEL_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
SUPPORTOPS_MODEL_MAIN_MODEL=qwen3.6-plus
SUPPORTOPS_MODEL_LIGHT_MODEL=qwen3.8-flash
SUPPORTOPS_MODEL_EMBEDDING_MODEL=qwen3.7-text-embedding
SUPPORTOPS_MODEL_RERANK_MODEL=qwen3.7-text-rerank
# 仅用于截图字段提取，原主 / 轻模型保持独立。
SUPPORTOPS_MODEL_VISION_MODEL=qwen-vl-plus
SUPPORTOPS_MODEL_EMBEDDING_DIMENSIONS=1024
SUPPORTOPS_MODEL_TIMEOUT_SECONDS=30
